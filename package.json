{
  "name": "cherrion",
  "version": "0.2.0",
  "private": true,
  "description": "End-to-end encrypted notes on Vercel + Postgres: tree hierarchy, block editor, sticky notes and templates.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
